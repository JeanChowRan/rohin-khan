/* ================= 地图解析 ================= */
function parseMap(){
  baseTiles = []; crumbles = new Map(); forests = new Map(); movers = []; portals = [];
  for (let y = 0; y < MAP_H; y++){
    const row = [];
    for (let x = 0; x < MAP_W; x++){
      const ch = MAP_STR[y][x];
      let t = T.FLOOR;
      if (ch === '#') t = T.WALL;
      else if (ch === '~') t = T.VOID;
      else if (ch === '.') t = T.FLOOR;
      else if (ch === 'o') t = T.FLOOR;
      else if (ch === 'F'){ t = T.FOREST; forests.set(x+','+y,{alive:true,burn:0}); }
      else if (ch === 'C'){ t = T.CRYSTAL; crumbles.set(x+','+y,{gone:false,timer:0,respawn:0}); }
      row.push(t);
    }
    baseTiles.push(row);
  }
  for (const cfg of MOVERS_CFG){
    movers.push({
      kind: cfg.kind, ox: cfg.ox, oy: cfg.oy,
      w: cfg.w, h: cfg.h, range: cfg.range, speed: cfg.speed,
      t: Math.random()*6.28,
      px: cfg.ox*TILE, py: cfg.oy*TILE
    });
  }
  for (const p of PORTALS){
    portals.push({ a: {x:p.a.x*TILE+TILE/2, y:p.a.y*TILE+TILE/2}, b: {x:p.b.x*TILE+TILE/2, y:p.b.y*TILE+TILE/2}, t: Math.random()*6.28 });
    portals.push({ a: {x:p.b.x*TILE+TILE/2, y:p.b.y*TILE+TILE/2}, b: {x:p.a.x*TILE+TILE/2, y:p.a.y*TILE+TILE/2}, t: Math.random()*6.28 });
  }
}

function tileAt(tx, ty){
  if (tx < 0 || tx >= MAP_W || ty < 0 || ty >= MAP_H) return T.WALL;
  return baseTiles[ty][tx];
}

/* 阻挡移动的格子（俯视） */
function isBlocking(tx, ty){
  const t = tileAt(tx, ty);
  if (t === T.WALL) return true;
  if (t === T.FOREST){
    const f = forests.get(tx+','+ty);
    return f && f.alive;
  }
  if (t === T.CRYSTAL){
    const c = crumbles.get(tx+','+ty);
    return c && !c.gone;
  }
  // 喷泉不可进入
  if (t === T.VOID) return false;
  return false;
}

/* 检查坐标是否在深渊（会掉落） */
function isVoid(tx, ty){
  return tileAt(tx, ty) === T.VOID;
}

function isFountain(tx, ty){
  // 喷泉硬编码坐标（从 MAP_STR 里的 W 判断，改成查地图配置）
  return false; // 用 fountainTiles 替代
}

/* 喷泉位置（手动） */
const FOUNTAINS = [
  { x: 11, y: 8 }, { x: 20, y: 8 }, { x: 11, y: 10 }, { x: 20, y: 10 }
];

function isNearFountain(px, py){
  for (const f of FOUNTAINS){
    const dx = px - (f.x*TILE + TILE/2);
    const dy = py - (f.y*TILE + TILE/2);
    if (dx*dx + dy*dy < (TILE*1.6)*(TILE*1.6)) return true;
  }
  return false;
}

/* ================= 移动碰撞（俯视） ================= */
function collideMove(e){
  // X 轴
  e.x += e.vx;
  const y1 = Math.floor(e.y/TILE), y2 = Math.floor((e.y+e.h-1)/TILE);
  if (e.vx > 0){
    const tx = Math.floor((e.x+e.w-1)/TILE);
    for (let ty = y1; ty <= y2; ty++)
      if (isBlocking(tx,ty)){ e.x = tx*TILE - e.w; e.vx = 0; break; }
  } else if (e.vx < 0){
    const tx = Math.floor(e.x/TILE);
    for (let ty = y1; ty <= y2; ty++)
      if (isBlocking(tx,ty)){ e.x = (tx+1)*TILE; e.vx = 0; break; }
  }
  // Y 轴
  e.y += e.vy;
  const x1 = Math.floor(e.x/TILE), x2 = Math.floor((e.x+e.w-1)/TILE);
  if (e.vy > 0){
    const ty = Math.floor((e.y+e.h-1)/TILE);
    for (let tx = x1; tx <= x2; tx++)
      if (isBlocking(tx,ty)){ e.y = ty*TILE - e.h; e.vy = 0; break; }
  } else if (e.vy < 0){
    const ty = Math.floor(e.y/TILE);
    for (let tx = x1; tx <= x2; tx++)
      if (isBlocking(tx,ty)){ e.y = (ty+1)*TILE; e.vy = 0; break; }
  }
}

/* ================= 玩家 ================= */
function teamSpawn(team, pos){
  const positions = [
    { x: 8,  y: 8 }, { x: 22, y: 8 },
    { x: 8,  y: 10 }, { x: 22, y: 10 },
  ];
  const p = positions[team % 4];
  const jitter = pos * 26;
  const dir = (team % 2 === 0) ? 1 : -1;
  return { x: p.x*TILE + dir*jitter, y: p.y*TILE };
}

function makePlayer(team, teamPos, index, isAI, difficulty){
  const sp = teamSpawn(team, teamPos);
  return {
    team, teamPos, index, isAI: !!isAI,
    aiDifficulty: difficulty || 'normal',
    x:sp.x, y:sp.y, w:20, h:20,
    vx:0, vy:0, facing: 0,  // 弧度
    dashTime:0, dashCd:0, swordTime:0, swordCd:0,
    bowCd:0, charging:false, chargeTime:0, aimAngle:0,
    arrows:ARROW_MAX, hp:3, maxHp:3,
    kills:0, deaths:0, ignitedBy:null,
    frozen:0,
    dead:false, deadTimer:0, rescueTimer:0,
    rescuable:true, deathReason:'',
    onFire:0, skill:null, hurtFlash:0,
    fallTimer:0,
    portalCd:0,
    spawnX:sp.x, spawnY:sp.y,
    inputs:{ left:0,right:0,up:0,down:0,jump:0,dash:0,sword:0,bow:0 },
    prevJump:0, prevDash:0, prevSword:0, prevBow:0,
    _aiBowCd:0, _aiChargeTarget:null, _aiCharging:false,
    _aiAttackTarget:null,
  };
}

function getHumanSlots(){
  const result = [];
  const counter = {};
  for (let t = 0; t < gameConfig.teams; t++) counter[t] = 0;
  for (let h = 0; h < gameConfig.humans; h++){
    const team = gameConfig.humanTeams[h] || 0;
    if (counter[team] >= gameConfig.perTeam) continue;
    const pos = counter[team]++;
    result.push(team * gameConfig.perTeam + pos);
  }
  return result;
}

function buildPlayers(){
  players = [];
  humanSlots = getHumanSlots();
  let idx = 0;
  for (let t = 0; t < gameConfig.teams; t++){
    for (let i = 0; i < gameConfig.perTeam; i++){
      const isAI = !humanSlots.includes(idx);
      players.push(makePlayer(t, i, idx, isAI, gameConfig.aiDiff));
      idx++;
    }
  }
  if (isHost) myIndex = humanSlots[0] || 0;
  else myIndex = humanSlots[mySlotIndex] || 0;
  myTeam = players[myIndex] ? players[myIndex].team : 0;
  if (players[myIndex]) players[myIndex].isAI = false;
}

function resetWorld(){
  parseMap();
  arrows = []; books = []; particles = [];
  worldTime = 0; bookTimer = 240;
  buildPlayers();
  gameState.timeLeft = ROUND_FRAMES;
  gameState.ended = false;
}

/* ================= 死亡 ================= */
function killPlayer(p, reason, killer){
  if (p.dead) return;
  p.dead = true; p.deadTimer = 0; p.rescueTimer = 0;
  p.onFire = 0; p.frozen = 0; p.skill = null;
  p.vx = 0; p.vy = 0;
  p.charging = false; p.chargeTime = 0;
  p.rescuable = RESCUE_RULES[reason] !== false;
  p.deathReason = REASON_TEXT[reason] || '死亡';
  p.deaths++;
  if (killer !== undefined && killer !== null && killer >= 0){
    const k = players[killer];
    if (k && k.team !== p.team) k.kills++;
  }
  const col = TEAMS[p.team].hex;
  spawnParticles(p.x+p.w/2, p.y+p.h/2, p.rescuable ? col : '#64748b',
    p.rescuable ? 20 : 34);
}

/* ================= 粒子 ================= */
function spawnParticles(x, y, color, n){
  for (let i = 0; i < n; i++){
    particles.push({
      x, y, vx:(Math.random()-0.5)*7, vy:(Math.random()-0.5)*7,
      life:30+Math.random()*25, maxLife:55, color, size:2+Math.random()*3
    });
  }
}

/* ================= 箭矢 ================= */
function fireArrow(p, worldAngle, power, onFire, onIce){
  const speed = 5 + power*9;
  const curve = -(0.01 - power*0.006);  // 轻微弧度
  arrows.push({
    x:p.x+p.w/2, y:p.y+p.h/2,
    angle:worldAngle, speed, curve,
    vx:Math.cos(worldAngle)*speed, vy:Math.sin(worldAngle)*speed,
    owner:p.index, onFire:!!onFire, onIce:!!onIce,
    stuck:false, life:900, trail:[]
  });
}

function updateArrows(){
  for (let i = arrows.length-1; i >= 0; i--){
    const a = arrows[i];
    if (a.stuck){
      if (worldTime % 40 === 0)
        particles.push({ x:a.x, y:a.y, vx:0, vy:0,
          life:20, maxLife:20, color: a.onIce ? '#a5f3fc' : '#fbbf24', size:2 });
      continue;
    }
    a.life--;
    if (a.life <= 0){ arrows.splice(i,1); continue; }
    a.angle += a.curve;
    a.vx = Math.cos(a.angle)*a.speed;
    a.vy = Math.sin(a.angle)*a.speed;
    a.x += a.vx; a.y += a.vy;
    a.trail.push({ x:a.x, y:a.y });
    if (a.trail.length > 10) a.trail.shift();
    if (a.onFire && worldTime % 2 === 0){
      particles.push({ x:a.x, y:a.y, vx:(Math.random()-0.5)*1.5, vy:(Math.random()-0.5)*1.5,
        life:16, maxLife:16, color:'#fb923c', size:2+Math.random()*2 });
    } else if (a.onIce && worldTime % 3 === 0){
      particles.push({ x:a.x, y:a.y, vx:(Math.random()-0.5)*1, vy:(Math.random()-0.5)*1,
        life:14, maxLife:14, color:'#a5f3fc', size:1.5+Math.random()*2 });
    }
    if (a.x < -50 || a.x > W+50 || a.y < -50 || a.y > H+50){ arrows.splice(i,1); continue; }
    const tx = Math.floor(a.x/TILE), ty = Math.floor(a.y/TILE);
    if (isBlocking(tx,ty)){
      a.stuck = true;
      a.x -= Math.cos(a.angle)*4;
      a.y -= Math.sin(a.angle)*4;
      spawnParticles(a.x, a.y, a.onFire ? '#fb923c' : a.onIce ? '#a5f3fc' : '#94a3b8', 5);
      if (a.onFire){
        for (let dy = -1; dy <= 1; dy++){
          for (let dx = -1; dx <= 1; dx++){
            const f = forests.get((tx+dx)+','+(ty+dy));
            if (f && f.alive && f.burn <= 0){
              f.burn = 180;
              spawnParticles((tx+dx)*TILE+TILE/2, (ty+dy)*TILE+TILE/2, '#fb923c', 8);
            }
          }
        }
      }
      continue;
    }
    const ownerTeam = players[a.owner] ? players[a.owner].team : -1;
    for (const p of players){
      if (p.index === a.owner || p.dead) continue;
      if (p.team === ownerTeam) continue;
      if (p.hurtFlash > 0 && !a.onFire && !a.onIce) continue;
      if (a.x > p.x && a.x < p.x+p.w && a.y > p.y && a.y < p.y+p.h){
        if (a.onFire){
          p.onFire = BURN_FRAMES;
          p.ignitedBy = a.owner;
          p.hurtFlash = 20;
          spawnParticles(p.x+p.w/2, p.y+p.h/2, '#fb923c', 12);
        } else if (a.onIce){
          p.frozen = FREEZE_FRAMES;
          p.hurtFlash = 20;
          p.charging = false; p.chargeTime = 0;
          spawnParticles(p.x+p.w/2, p.y+p.h/2, '#a5f3fc', 14);
        } else {
          p.hp--;
          p.hurtFlash = 30;
          if (p.hp <= 0){
            killPlayer(p, p.frozen > 0 ? 'freeze' : 'arrow', a.owner);
          }
        }
        spawnParticles(a.x, a.y, '#f87171', 8);
        arrows.splice(i,1);
        break;
      }
    }
    // 剑格挡
    for (const p of players){
      if (p.dead || p.swordTime <= 0) continue;
      const sx = p.x + p.w/2 + Math.cos(p.facing)*10;
      const sy = p.y + p.h/2 + Math.sin(p.facing)*10;
      if (Math.hypot(a.x - sx, a.y - sy) < 22){
        a.angle = Math.atan2(a.y - sy, a.x - sx);
        a.owner = p.index;
        a.speed *= 1.15;
        a.vx = Math.cos(a.angle)*a.speed;
        a.vy = Math.sin(a.angle)*a.speed;
        spawnParticles(a.x, a.y, '#facc15', 6);
      }
    }
  }
}

/* ================= 技能书 ================= */
function spawnBook(){
  for (let attempt = 0; attempt < 80; attempt++){
    const tx = 3 + Math.floor(Math.random()*(MAP_W-6));
    const ty = 6 + Math.floor(Math.random()*(MAP_H-8));
    const t = tileAt(tx, ty);
    if (t === T.FLOOR && !isNearFountain(tx*TILE+TILE/2, ty*TILE+TILE/2)){
      const type = BOOK_TYPES[Math.floor(Math.random()*BOOK_TYPES.length)];
      books.push({ x:tx*TILE+TILE/2, y:ty*TILE+TILE/2,
        type, life:1200, bob:Math.random()*Math.PI*2 });
      return;
    }
  }
}

/* ================= 玩家更新 ================= */
function updatePlayer(p){
  if (p.dead){
    p.deadTimer++;
    if (!p.rescuable) return;
    for (const other of players){
      if (other.index === p.index || other.dead || other.team !== p.team) continue;
      const overlap = p.x < other.x+other.w && p.x+p.w > other.x &&
                      p.y < other.y+other.h && p.y+p.h > other.y;
      if (overlap){
        p.rescueTimer++;
        if (p.rescueTimer >= RESCUE_FRAMES){
          p.dead = false; p.rescueTimer = 0;
          p.arrows = ARROW_MAX; p.hp = p.maxHp;
          p.x = p.spawnX; p.y = p.spawnY;
          p.vx = 0; p.vy = 0;
          p.ignitedBy = null; p.frozen = 0;
          spawnParticles(p.x+p.w/2, p.y+p.h/2, '#4ade80', 24);
        }
        return;
      }
    }
    p.rescueTimer = 0;
    return;
  }

  if (p.portalCd > 0) p.portalCd--;

  /* 冻结 */
  if (p.frozen > 0){
    p.frozen--;
    p.inputs = { left:0,right:0,up:0,down:0,jump:0,dash:0,sword:0,bow:0 };
    p.charging = false; p.chargeTime = 0;
    if (worldTime % 8 === 0){
      particles.push({
        x: p.x + p.w/2 + (Math.random()-0.5)*14,
        y: p.y + p.h/2 + (Math.random()-0.5)*14,
        vx:0, vy:-0.3,
        life:16, maxLife:16, color:'#a5f3fc', size:1.5+Math.random()*1.5
      });
    }
  }

  /* 燃烧 */
  if (p.onFire > 0){
    p.onFire--;
    if (worldTime % 4 === 0){
      particles.push({
        x: p.x + p.w/2 + (Math.random()-0.5)*12,
        y: p.y + p.h/2 + (Math.random()-0.5)*12,
        vx:(Math.random()-0.5)*1, vy:-Math.random()*1.5 - 0.3,
        life:18, maxLife:18, color: Math.random()<0.5?'#fb923c':'#fbbf24',
        size:2+Math.random()*2
      });
    }
    if (p.onFire <= 0){
      killPlayer(p, 'burn', p.ignitedBy);
      return;
    }
  }

  /* 传染 */
  if (p.onFire <= 0){
    for (const q of players){
      if (q === p || q.dead || q.onFire <= 0) continue;
      const dx = Math.abs((p.x+p.w/2) - (q.x+q.w/2));
      const dy = Math.abs((p.y+p.h/2) - (q.y+q.h/2));
      if (dx < 22 && dy < 22){
        p.onFire = BURN_FRAMES;
        p.ignitedBy = q.ignitedBy;
        p.hurtFlash = 20;
        spawnParticles(p.x+p.w/2, p.y+p.h/2, '#fb923c', 12);
        break;
      }
    }
  }

  /* 喷泉灭火 */
  if (p.onFire > 0 && isNearFountain(p.x+p.w/2, p.y+p.h/2)){
    p.onFire = 0;
    spawnParticles(p.x+p.w/2, p.y+p.h/2, '#7dd3fc', 16);
  }

  /* 燃烧的森林 */
  if (p.onFire <= 0 && p.frozen <= 0){
    for (let ty = Math.floor(p.y/TILE); ty <= Math.floor((p.y+p.h-1)/TILE); ty++){
      for (let tx = Math.floor(p.x/TILE); tx <= Math.floor((p.x+p.w-1)/TILE); tx++){
        const f = forests.get(tx+','+ty);
        if (f && f.burn > 0){
          p.onFire = BURN_FRAMES;
          p.ignitedBy = null;
          p.hurtFlash = 20;
          spawnParticles(p.x+p.w/2, p.y+p.h/2, '#fb923c', 10);
          break;
        }
      }
      if (p.onFire > 0) break;
    }
  }

  if (p.skill && p.skill.type !== 'burn'){
    p.skill.timer--;
    if (p.skill.timer <= 0) p.skill = null;
  }
  if (p.hurtFlash > 0) p.hurtFlash--;
  if (p.dashCd > 0) p.dashCd--;
  if (p.swordCd > 0) p.swordCd--;
  if (p.bowCd > 0) p.bowCd--;
  if (p.swordTime > 0) p.swordTime--;

  const inp = p.inputs;
  let ax = 0, ay = 0;
  if (inp.left) ax -= 1;
  if (inp.right) ax += 1;
  if (inp.up) ay -= 1;
  if (inp.down) ay += 1;
  if (p.skill && p.skill.type === 'swap'){ ax = -ax; ay = -ay; }

  /* 朝向由移动方向决定 */
  if (ax !== 0 || ay !== 0){
    if (p.charging) {
      // 蓄力时不再改变朝向（朝向已锁定为 aimAngle 对应的方向）
    } else {
      p.facing = Math.atan2(ay, ax);
    }
  }

  /* 冲刺 */
  if (inp.dash && !p.prevDash && p.dashCd <= 0 && p.dashTime <= 0 && (ax || ay)){
    p.dashTime = DASH_TIME; p.dashCd = DASH_CD;
    spawnParticles(p.x+p.w/2, p.y+p.h/2, '#60a5fa', 8);
  }

  const mag = Math.hypot(ax, ay) || 1;
  const nx = ax/mag, ny = ay/mag;

  if (p.dashTime > 0){
    p.dashTime--;
    p.vx = Math.cos(p.facing) * DASH_SPEED;
    p.vy = Math.sin(p.facing) * DASH_SPEED;
  } else {
    p.vx = nx * MOVE_SPEED;
    p.vy = ny * MOVE_SPEED;
  }

  if (inp.sword && !p.prevSword && p.swordCd <= 0){
    p.swordTime = 14; p.swordCd = 24;
  }

  /* 射箭 */
  const skillType = p.skill ? p.skill.type : null;
  if (inp.bow){
    if (!p.charging){ p.charging = true; p.chargeTime = 0; p.aimAngle = p.facing; }
    p.chargeTime = Math.min(p.chargeTime + 1, 60);
    // 蓄力时 WASD 调整朝向
    if (ax || ay) p.facing = Math.atan2(ay, ax);
    p.aimAngle = p.facing;
  } else if (p.charging){
    const power = p.chargeTime / 60;
    const worldAngle = p.aimAngle;
    const onFire = skillType === 'fire';
    const onIce = skillType === 'ice';
    if (p.arrows > 0){
      p.arrows--;
      if (skillType === 'multi'){
        for (let k = -2; k <= 2; k++) fireArrow(p, worldAngle + k*0.14, power, onFire, onIce);
      } else if (skillType === 'double'){
        fireArrow(p, worldAngle - 0.06, power, onFire, onIce);
        fireArrow(p, worldAngle + 0.06, power, onFire, onIce);
      } else {
        fireArrow(p, worldAngle, power, onFire, onIce);
      }
    }
    p.charging = false; p.chargeTime = 0;
  }

  /* 移动碰撞 */
  collideMove(p);

  /* 传送门 */
  if (p.portalCd <= 0){
    for (const po of portals){
      if (Math.hypot(p.x+p.w/2 - po.a.x, p.y+p.h/2 - po.a.y) < 18){
        p.x = po.b.x - p.w/2;
        p.y = po.b.y - p.h/2;
        p.portalCd = 40;
        spawnParticles(po.a.x, po.a.y, '#c026d3', 16);
        spawnParticles(po.b.x, po.b.y, '#c026d3', 16);
        break;
      }
    }
  }

  /* 深渊坠落 */
  const cx = Math.floor((p.x+p.w/2)/TILE);
  const cy = Math.floor((p.y+p.h/2)/TILE);
  if (isVoid(cx, cy)){
    p.fallTimer++;
    if (p.fallTimer > FALL_GRACE){
      killPlayer(p, 'fall', null);
      return;
    }
  } else {
    p.fallTimer = 0;
  }

  /* 移动墙 */
  for (const m of movers){
    const mw = m.w*TILE, mh = m.h*TILE;
    if (p.x < m.px + mw && p.x + p.w > m.px &&
        p.y < m.py + mh && p.y + p.h > m.py){
      killPlayer(p, 'crush', null);
      return;
    }
  }

  /* 掉落块触发 */
  if (tileAt(cx, cy) === T.CRYSTAL){
    const c = crumbles.get(cx+','+cy);
    if (c && !c.gone && c.timer === 0) c.timer = 1;
  }

  /* 捡箭 */
  for (let i = arrows.length-1; i >= 0; i--){
    const a = arrows[i];
    if (!a.stuck) continue;
    if (Math.abs(a.x-(p.x+p.w/2)) < 20 && Math.abs(a.y-(p.y+p.h/2)) < 20){
      if (p.arrows < ARROW_MAX){
        p.arrows++;
        spawnParticles(a.x, a.y,
          a.onIce ? '#a5f3fc' : a.onFire ? '#fb923c' : '#fbbf24', 5);
        arrows.splice(i,1);
      }
    }
  }
  /* 捡技能书 */
  for (let i = books.length-1; i >= 0; i--){
    const b = books[i];
    if (Math.abs(b.x-(p.x+p.w/2)) < 22 && Math.abs(b.y-(p.y+p.h/2)) < 22){
      applySkill(p, b.type);
      spawnParticles(b.x, b.y, SKILLS[b.type].color, 14);
      books.splice(i,1);
    }
  }
  p.prevJump = inp.jump; p.prevDash = inp.dash;
  p.prevSword = inp.sword; p.prevBow = inp.bow;
}

function applySkill(p, type){
  const def = SKILLS[type];
  if (!def) return;
  p.skill = { type, timer:def.dur };
  showSkillBanner(p.index, def.name, def.color);
}

function showSkillBanner(playerIndex, skillName, skillColor){
  const el = document.getElementById('skillBanner');
  let who;
  if (playerIndex === myIndex) who = '你';
  else if (players[playerIndex] && players[playerIndex].isAI)
    who = 'AI·' + TEAMS[players[playerIndex].team].name;
  else who = '对手';
  el.textContent = `${who}吃到了「${skillName}」`;
  el.style.borderColor = skillColor;
  el.style.color = skillColor;
  el.style.boxShadow = `0 0 40px ${skillColor}80`;
  el.style.animation = 'none';
  void el.offsetHeight;
  el.style.animation = 'skillPop 2s ease forwards';
  el.classList.remove('hidden');
}

/* ================= 地形更新 ================= */
function updateTerrain(){
  worldTime++;

  for (const [key, c] of crumbles){
    if (c.gone){
      c.respawn--;
      if (c.respawn <= 0){ c.gone = false; c.timer = 0; }
    } else if (c.timer > 0){
      c.timer++;
      if (c.timer > 900){
        c.gone = true; c.timer = 0; c.respawn = 900;
        const [tx, ty] = key.split(',').map(Number);
        spawnParticles(tx*TILE+TILE/2, ty*TILE+TILE/2, '#67e8f9', 14);
      }
    }
  }

  for (const [key, f] of forests){
    if (f.burn > 0){
      f.burn--;
      if (worldTime % 3 === 0){
        const [tx, ty] = key.split(',').map(Number);
        particles.push({
          x: tx*TILE + Math.random()*TILE,
          y: ty*TILE + Math.random()*TILE,
          vx:(Math.random()-0.5)*1.5, vy:-Math.random()*1.5 - 0.5,
          life:20, maxLife:20, color: Math.random()<0.5?'#fb923c':'#fbbf24',
          size:2+Math.random()*3
        });
      }
      if (f.burn <= 0){
        f.alive = false;
        const [tx, ty] = key.split(',').map(Number);
        spawnParticles(tx*TILE+TILE/2, ty*TILE+TILE/2, '#94a3b8', 16);
      }
    }
  }

  for (const m of movers){
    m.t += m.speed;
    if (m.kind === 'h'){ m.px = (m.ox + Math.sin(m.t)*m.range)*TILE; m.py = m.oy*TILE; }
    else { m.px = m.ox*TILE; m.py = (m.oy + Math.sin(m.t)*m.range)*TILE; }
  }

  for (const po of portals) po.t += 0.03;

  for (let i = particles.length-1; i >= 0; i--){
    const pt = particles[i];
    pt.x += pt.vx; pt.y += pt.vy; pt.vy += 0.05;
    pt.life--;
    if (pt.life <= 0) particles.splice(i,1);
  }

  bookTimer--;
  if (bookTimer <= 0 && books.length < 4){
    spawnBook();
    bookTimer = 400 + Math.random()*300;
  }
  for (let i = books.length-1; i >= 0; i--){
    books[i].life--;
    books[i].bob += 0.08;
    if (books[i].life <= 0) books.splice(i,1);
  }
}

/* ================= AI（分散击杀 + 保命优先 + 就近索敌 + 不掉陷阱） ================= */
const AI_CFG = {
  easy:   { skillRange:150, keepDist:200, accuracy:0.25, reactRange:180, safeMargin:30 },
  normal: { skillRange:220, keepDist:220, accuracy:0.55, reactRange:280, safeMargin:40 },
  hard:   { skillRange:300, keepDist:230, accuracy:0.82, reactRange:360, safeMargin:50 },
  hell:   { skillRange:400, keepDist:240, accuracy:0.96, reactRange:480, safeMargin:60 },
};

/* 检查某个方向是否安全（不会掉入深渊） */
function isSafeDirection(px, py, dirX, dirY, dist){
  const tx = Math.floor((px + dirX*dist)/TILE);
  const ty = Math.floor((py + dirY*dist)/TILE);
  return !isVoid(tx, ty);
}

/* 检查目标位置周围是否有深渊 */
function nearVoid(px, py, margin){
  for (let dy = -margin; dy <= margin; dy += TILE){
    for (let dx = -margin; dx <= margin; dx += TILE){
      const tx = Math.floor((px+dx)/TILE);
      const ty = Math.floor((py+dy)/TILE);
      if (isVoid(tx, ty)) return true;
    }
  }
  return false;
}

function updateAI(ai){
  if (ai.dead || gameState.ended) return;
  if (ai.frozen > 0){
    ai.inputs = { left:0,right:0,up:0,down:0,jump:0,dash:0,sword:0,bow:0 };
    return;
  }
  const cfg = AI_CFG[ai.aiDifficulty] || AI_CFG.normal;
  const inp = ai.inputs;
  inp.left = inp.right = inp.up = inp.down = 0;
  inp.jump = inp.dash = inp.sword = 0;
  if (ai._aiBowCd > 0) ai._aiBowCd--;

  /* 1. 就近索敌：找最近敌人，但每个 AI 倾向于不同敌人（分散击杀） */
  let enemy = null, enemyDist = Infinity;
  for (const p of players){
    if (p.team === ai.team || p.dead) continue;
    let d = Math.hypot(p.x - ai.x, p.y - ai.y);
    // 其他 AI 已经锁定的敌人，优先级降低
    if (p._aiTargetCount && p._aiTargetCount > 0) d *= 1.5;
    if (d < enemyDist){ enemyDist = d; enemy = p; }
  }
  if (enemy){
    if (!enemy._aiTargetCount) enemy._aiTargetCount = 0;
    enemy._aiTargetCount++;
    setTimeout(() => { if (enemy._aiTargetCount) enemy._aiTargetCount--; }, 100);
  }

  /* 2. 找倒地队友 */
  let downedMate = null, mateDist = Infinity;
  for (const p of players){
    if (p.team !== ai.team || p.index === ai.index) continue;
    if (p.dead && p.rescuable){
      const d = Math.hypot(p.x - ai.x, p.y - ai.y);
      if (d < mateDist){ mateDist = d; downedMate = p; }
    }
  }

  /* 3. 找可捡的箭 */
  let freeArrow = null, arrowDist = Infinity;
  for (const a of arrows){
    if (!a.stuck) continue;
    const d = Math.hypot(a.x - ai.x, a.y - ai.y);
    if (d < arrowDist){ arrowDist = d; freeArrow = a; }
  }

  /* 4. 找技能书 */
  let book = null, bookDist = Infinity;
  for (const b of books){
    const d = Math.hypot(b.x - ai.x, b.y - ai.y);
    if (d < bookDist){ bookDist = d; book = b; }
  }

  /* 5. 找喷泉（着火时） */
  let fountain = null, fDist = Infinity;
  if (ai.onFire > 0){
    for (const f of FOUNTAINS){
      const d = Math.hypot(f.x*TILE+TILE/2 - ai.x, f.y*TILE+TILE/2 - ai.y);
      if (d < fDist){ fDist = d; fountain = f; }
    }
  }

  /* === 决策优先级：保命 > 掉陷阱 > 就近索敌击杀 > 救人 > 吃技能 === */
  let tx = null, ty = null;
  let mode = 'idle';

  // 优先级 1：着火 → 跑向喷泉
  if (ai.onFire > 0 && fountain){
    tx = fountain.x*TILE+TILE/2; ty = fountain.y*TILE+TILE/2;
    mode = 'fountain';
  }
  // 优先级 2：血量低且敌人近 → 逃跑
  else if (ai.hp <= 1 && enemy && enemyDist < 200){
    tx = ai.x + Math.sign(ai.x - enemy.x) * 200;
    ty = ai.y + Math.sign(ai.y - enemy.y) * 200;
    mode = 'flee';
  }
  // 优先级 3：积极击杀（就近索敌）
  else if (enemy && enemyDist < cfg.reactRange){
    const ideal = cfg.keepDist;
    const dx = enemy.x - ai.x, dy = enemy.y - ai.y;
    const d = Math.hypot(dx, dy);
    if (d < ideal - 50){
      // 太近，后撤
      tx = ai.x - (dx/d) * 80;
      ty = ai.y - (dy/d) * 80;
    } else if (d > ideal + 60){
      // 太远，靠近
      tx = ai.x + (dx/d) * 100;
      ty = ai.y + (dy/d) * 100;
    } else {
      // 距离合适，微调保持位置
      tx = ai.x; ty = ai.y;
    }
    mode = 'fight';
  }
  // 优先级 4：救人
  else if (downedMate && mateDist < 300){
    tx = downedMate.x; ty = downedMate.y; mode = 'rescue';
  }
  // 优先级 5：捡箭（箭少时）
  else if (ai.arrows <= 2 && freeArrow && arrowDist < 280){
    tx = freeArrow.x; ty = freeArrow.y; mode = 'collect';
  }
  // 优先级 6：吃技能书
  else if (book && bookDist < cfg.skillRange){
    tx = book.x; ty = book.y; mode = 'skill';
  }
  // 优先级 7：无目标 → 巡游
  else if (enemy){
    // 缓慢靠近敌人，但保持距离
    const dx = enemy.x - ai.x, dy = enemy.y - ai.y;
    const d = Math.hypot(dx, dy) || 1;
    tx = ai.x + (dx/d) * 50;
    ty = ai.y + (dy/d) * 50;
    mode = 'roam';
  }

  /* === 移动（含避陷阱） === */
  if (tx !== null){
    const dx = tx - ai.x, dy = ty - ai.y;
    const d = Math.hypot(dx, dy) || 1;
    let mx = 0, my = 0;
    if (Math.abs(dx) > 10) mx = Math.sign(dx);
    if (Math.abs(dy) > 10) my = Math.sign(dy);

    // 避陷阱：如果移动方向前方有深渊，尝试垂直绕行
    if (mx && !isSafeDirection(ai.x + ai.w/2, ai.y + ai.h/2, mx, 0, 24)){
      if (isSafeDirection(ai.x + ai.w/2, ai.y + ai.h/2, 0, 1, 24)) my = 1;
      else if (isSafeDirection(ai.x + ai.w/2, ai.y + ai.h/2, 0, -1, 24)) my = -1;
      else mx = 0;
    }
    if (my && !isSafeDirection(ai.x + ai.w/2, ai.y + ai.h/2, 0, my, 24)){
      if (isSafeDirection(ai.x + ai.w/2, ai.y + ai.h/2, 1, 0, 24)) mx = 1;
      else if (isSafeDirection(ai.x + ai.w/2, ai.y + ai.h/2, -1, 0, 24)) mx = -1;
      else my = 0;
    }

    // 避免站在深渊边缘
    if (nearVoid(ai.x + ai.w/2 + mx*24, ai.y + ai.h/2 + my*24, cfg.safeMargin)){
      mx = 0; my = 0;
    }

    if (mx < 0) inp.left = 1;
    else if (mx > 0) inp.right = 1;
    if (my < 0) inp.up = 1;
    else if (my > 0) inp.down = 1;
  }

  /* 朝向敌人（战斗中） */
  if (enemy && (mode === 'fight' || mode === 'chase' || mode === 'roam')){
    ai.facing = Math.atan2(enemy.y - ai.y, enemy.x - ai.x);
  } else if (tx !== null){
    ai.facing = Math.atan2(ty - ai.y, tx - ai.x);
  }

  /* 射箭 */
  if ((mode === 'fight' || mode === 'roam') && enemy){
    if (ai._aiCharging){
      inp.bow = 1;
      const desiredAngle = Math.atan2(enemy.y - ai.y, enemy.x - ai.x);
      const err = (1 - cfg.accuracy) * 0.4 * (Math.random() - 0.5);
      ai.facing = desiredAngle + err;
      if (ai.chargeTime >= 30 || ai.arrows <= 0){
        inp.bow = 0; ai._aiCharging = false;
        ai._aiBowCd = 45 + Math.random() * 55;
      }
    } else if (ai._aiBowCd <= 0 && ai.arrows > 0 && enemyDist < cfg.reactRange){
      ai._aiCharging = true; inp.bow = 1;
    }
  } else if (ai._aiCharging){
    inp.bow = 0; ai._aiCharging = false;
  }

  /* 冲刺加速（救人或捡箭） */
  if (ai.dashCd <= 0 && (mode === 'rescue' || mode === 'collect' || mode === 'fountain')
      && tx !== null && Math.hypot(tx - ai.x, ty - ai.y) > 150){
    if (Math.random() < 0.03) inp.dash = 1;
  }

  /* 清理敌方锁定的临时计数 */
  for (const p of players){
    if (p._aiTargetCount && Math.random() < 0.02) p._aiTargetCount--;
  }
}

/* ================= 游戏结束 ================= */
function teamAliveCount(team){
  let n = 0;
  for (const p of players){ if (p.team === team && !p.dead) n++; }
  return n;
}

function checkGameEnd(){
  if (gameState.ended) return;
  gameState.timeLeft--;
  const alive = [];
  for (let t = 0; t < gameConfig.teams; t++){
    if (teamAliveCount(t) > 0) alive.push(t);
  }
  if (alive.length <= 1 || gameState.timeLeft <= 0) endGame();
}

function endGame(){
  if (gameState.ended) return;
  gameState.ended = true;
  const stats = [];
  for (let t = 0; t < gameConfig.teams; t++){
    let alive = 0, kills = 0, totalHp = 0;
    for (const p of players){
      if (p.team !== t) continue;
      if (!p.dead){ alive++; totalHp += p.hp; }
      kills += p.kills;
    }
    stats.push({ team: t, alive, kills, totalHp });
  }
  const sorted = [...stats].sort((a,b) =>
    b.alive - a.alive || b.kills - a.kills || b.totalHp - a.totalHp);
  const winnerTeam = sorted[0].team;
  let mvp = players[0];
  for (const p of players){ if (p.kills > mvp.kills) mvp = p; }
  showResult(winnerTeam, sorted, mvp);
}

function showResult(winnerTeam, sorted, mvp){
  const wt = TEAMS[winnerTeam];
  document.getElementById('winnerTitle').textContent = `🏆 ${wt.name} 获胜！`;
  document.getElementById('winnerTitle').style.color = wt.hex;
  document.getElementById('winnerSub').textContent =
    gameState.timeLeft <= 0 ? '时间耗尽 · 按存活数结算' : '其他阵营已全部倒下';
  const maxAlive = Math.max(1, ...sorted.map(s => s.alive));
  let html = '';
  for (const s of sorted){
    const t = TEAMS[s.team];
    const barW = (s.alive / maxAlive) * 100;
    const isW = s.team === winnerTeam;
    html += `<div class="stat-row ${isW ? 'winner-row' : ''}">
      <span class="dot" style="background:${t.hex}"></span>
      <span style="min-width:48px;font-weight:${isW?'700':'400'}">${t.name}</span>
      <span style="min-width:54px;color:#94a3b8;font-size:12px">${s.alive}/${gameConfig.perTeam} 存活</span>
      <div class="stat-bar"><div class="stat-bar-fill" style="width:${barW}%;background:${t.hex}"></div></div>
      <span style="min-width:44px;text-align:right;color:#fbbf24;font-size:12px">${s.kills} 击杀</span>
    </div>`;
  }
  document.getElementById('statsList').innerHTML = html;
  const mt = TEAMS[mvp.team];
  const mvpName = mvp.index === myIndex ? '你' :
    (mvp.isAI ? 'AI·' + mt.name : mt.name + '·玩家');
  document.getElementById('mvpName').textContent = `MVP · ${mvpName}`;
  document.getElementById('mvpName').style.color = mt.hex;
  document.getElementById('mvpStats').textContent =
    `${mvp.kills} 击杀 · ${mvp.deaths} 阵亡 · ${mt.name}`;
  document.getElementById('resultModal').classList.add('active');
}

/* ================= 渲染 ================= */
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');

function drawFloorTile(tx, ty, img){
  ctx.drawImage(img, tx*TILE, ty*TILE, TILE, TILE);
}

function drawPlayer(p){
  const team = TEAMS[p.team];
  if (p.dead){
    const cx = p.x+p.w/2, cy = p.y+p.h/2;
    const canRescue = p.rescuable;
    ctx.fillStyle = canRescue ? 'rgba(71,85,105,.85)' : 'rgba(28,25,23,.85)';
    ctx.beginPath(); ctx.arc(cx, cy, 11, 0, Math.PI*2); ctx.fill();
    ctx.strokeStyle = canRescue ? '#94a3b8' : '#7f1d1d';
    ctx.lineWidth = 1.5;
    ctx.stroke();
    ctx.fillStyle = canRescue ? '#94a3b8' : '#7f1d1d';
    ctx.font = 'bold 10px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(canRescue ? 'RIP' : '☠', cx, cy);
    ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic';
    if (canRescue && p.rescueTimer > 0){
      const prog = p.rescueTimer / RESCUE_FRAMES;
      ctx.fillStyle = 'rgba(0,0,0,.7)';
      ctx.fillRect(cx-20, cy-20, 40, 6);
      ctx.fillStyle = '#4ade80';
      ctx.fillRect(cx-19, cy-19, 38*prog, 4);
    }
    return;
  }

  const cx = p.x+p.w/2, cy = p.y+p.h/2;
  const flick = p.hurtFlash > 0 && p.hurtFlash % 4 < 2;

  // 阴影
  ctx.fillStyle = 'rgba(0,0,0,0.35)';
  ctx.beginPath();
  ctx.ellipse(cx, cy + 6, p.w/2 + 2, p.h/3, 0, 0, Math.PI*2);
  ctx.fill();

  // 冻结光环
  if (p.frozen > 0){
    ctx.save();
    ctx.shadowBlur = 18; ctx.shadowColor = '#a5f3fc';
    ctx.strokeStyle = '#a5f3fc';
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(cx, cy, p.w/2 + 6, 0, Math.PI*2); ctx.stroke();
    ctx.restore();
  }

  // 燃烧光环
  if (p.onFire > 0){
    ctx.save();
    ctx.shadowBlur = 24; ctx.shadowColor = '#f97316';
    ctx.fillStyle = 'rgba(249,115,22,.4)';
    ctx.beginPath(); ctx.arc(cx, cy, p.w/2 + 10, 0, Math.PI*2); ctx.fill();
    ctx.restore();
    // 火焰粒子环绕
    for (let i = 0; i < 6; i++){
      const ang = worldTime*0.15 + i * Math.PI/3;
      const r = p.w/2 + 8 + Math.sin(worldTime*0.3 + i)*3;
      const px = cx + Math.cos(ang)*r;
      const py = cy + Math.sin(ang)*r;
      const alpha = 0.6 + 0.4*Math.sin(worldTime*0.4 + i);
      ctx.fillStyle = `rgba(251,146,60,${alpha})`;
      ctx.beginPath(); ctx.arc(px, py, 2.5, 0, Math.PI*2); ctx.fill();
    }
  }

  // 传送冷却
  if (p.portalCd > 0){
    ctx.save();
    ctx.globalAlpha = 0.6;
    ctx.strokeStyle = '#c026d3';
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(cx, cy, p.w/2 + 4, 0, Math.PI*2); ctx.stroke();
    ctx.restore();
  }

  // 角色本体（按朝向旋转）
  ctx.save();
  ctx.translate(cx, cy);
  ctx.rotate(p.facing + Math.PI/2); // SVG 顶部朝上，需要旋转对齐
  if (flick) ctx.globalAlpha = 0.5;
  ctx.drawImage(SPR.player[p.team], -p.w/2 - 2, -p.h/2 - 2, p.w + 4, p.h + 4);
  ctx.restore();
  ctx.globalAlpha = 1;

  // 冻结冰晶
  if (p.frozen > 0){
    ctx.save();
    ctx.globalAlpha = 0.7;
    ctx.strokeStyle = '#e0f2fe'; ctx.lineWidth = 1.2;
    for (let i = 0; i < 6; i++){
      const ang = i * Math.PI/3;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(cx + Math.cos(ang)*10, cy + Math.sin(ang)*10);
      ctx.stroke();
    }
    ctx.restore();
    ctx.fillStyle = '#a5f3fc';
    ctx.font = 'bold 9px sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('❄' + Math.ceil(p.frozen/60) + 's', cx, cy - p.h/2 - 8);
    ctx.textAlign = 'left';
  }

  // 己方指示
  if (p.index === myIndex){
    ctx.save();
    ctx.strokeStyle = '#fbbf24'; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(cx, cy, p.w/2 + 5, 0, Math.PI*2); ctx.stroke();
    ctx.restore();
  }
  // AI 标记
  if (p.isAI){
    ctx.fillStyle = team.hex;
    ctx.font = 'bold 8px sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('AI', cx, cy - p.h/2 - 12);
    ctx.textAlign = 'left';
  }

  // 剑
  if (p.swordTime > 0){
    const sx = cx + Math.cos(p.facing) * 18;
    const sy = cy + Math.sin(p.facing) * 18;
    ctx.save();
    ctx.translate(sx, sy);
    ctx.rotate(p.facing);
    ctx.fillStyle = '#e2e8f0';
    ctx.fillRect(-3, -2, 18, 4);
    ctx.fillStyle = '#facc15';
    ctx.fillRect(-6, -4, 4, 8);
    ctx.restore();
    ctx.strokeStyle = 'rgba(250,204,21,.7)';
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.arc(cx, cy, 28, p.facing - 0.6, p.facing + 0.6);
    ctx.stroke();
    ctx.lineWidth = 1;
  }

  // 蓄力瞄准线
  if (p.charging){
    const t = p.chargeTime / 60;
    const len = 40 + t * 160;
    const skillType = p.skill ? p.skill.type : null;
    const lineColor = skillType === 'fire' ? '251,146,60' :
                      skillType === 'ice' ? '165,243,252' : '56,189,248';
    const ex = cx + Math.cos(p.facing) * len;
    const ey = cy + Math.sin(p.facing) * len;
    ctx.strokeStyle = `rgba(${lineColor},${0.55 + t*0.45})`;
    ctx.setLineDash([6,4]);
    ctx.lineWidth = 1 + t*2;
    ctx.beginPath();
    ctx.moveTo(cx, cy);
    ctx.lineTo(ex, ey);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.lineWidth = 1;
    ctx.strokeStyle = skillType === 'fire' ? '#fb923c' :
                      skillType === 'ice' ? '#a5f3fc' : '#38bdf8';
    ctx.beginPath();
    ctx.moveTo(ex-5, ey); ctx.lineTo(ex+5, ey);
    ctx.moveTo(ex, ey-5); ctx.lineTo(ex, ey+5);
    ctx.stroke();
    // 蓄力条
    ctx.fillStyle = 'rgba(0,0,0,.7)';
    ctx.fillRect(cx-16, cy - p.h/2 - 20, 32, 5);
    ctx.fillStyle = t < 0.5 ? '#38bdf8' : t < 0.85 ? '#a78bfa' : '#f472b6';
    ctx.fillRect(cx-15, cy - p.h/2 - 19, 30*t, 3);
  }

  // 技能图标
  if (p.skill){
    const def = SKILLS[p.skill.type];
    ctx.font = '14px sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText(def.icon, cx, cy - p.h/2 - 14);
    ctx.textAlign = 'left';
    const prog = p.skill.timer / def.dur;
    ctx.fillStyle = 'rgba(0,0,0,.5)';
    ctx.fillRect(cx-11, cy - p.h/2 - 6, 22, 3);
    ctx.fillStyle = def.color;
    ctx.fillRect(cx-10, cy - p.h/2 - 5, 20*prog, 2);
  }

  // 箭数
  ctx.fillStyle = 'rgba(15,23,42,.85)';
  ctx.fillRect(cx - 11, cy + p.h/2 + 4, 22, 11);
  ctx.fillStyle = team.hex;
  ctx.font = 'bold 9px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('🏹'+p.arrows, cx, cy + p.h/2 + 13);
  ctx.textAlign = 'left';
}

function render(){
  // 背景天空色
  ctx.fillStyle = '#020617';
  ctx.fillRect(0, 0, W, H);

  // 瓦片
  for (let y = 0; y < MAP_H; y++){
    for (let x = 0; x < MAP_W; x++){
      const t = baseTiles[y][x];
      if (t === T.WALL) drawFloorTile(x, y, SPR.wall);
      else if (t === T.VOID) drawFloorTile(x, y, SPR.void);
      else if (t === T.FLOOR) {
        // 判断是小岛还是大陆
        const isIsle = (y <= 3 || y >= 14) && (x <= 5 || x >= 26);
        drawFloorTile(x, y, isIsle ? SPR.isle : SPR.floor);
      }
    }
  }

  // 喷泉
  for (const f of FOUNTAINS){
    ctx.save();
    ctx.shadowBlur = 12;
    ctx.shadowColor = '#38bdf8';
    ctx.drawImage(SPR.fountain, f.x*TILE, f.y*TILE, TILE, TILE);
    ctx.restore();
    // 上升气泡
    if (worldTime % 15 === 0){
      particles.push({
        x: f.x*TILE + TILE/2 + (Math.random()-0.5)*8,
        y: f.y*TILE + TILE/2,
        vx:(Math.random()-0.5)*0.3,
        vy:-0.5 - Math.random()*0.5,
        life:36, maxLife:36, color:'#bae6fd', size:1.5
      });
    }
  }

  // 传送门
  for (const po of portals){
    ctx.save();
    ctx.translate(po.a.x, po.a.y);
    ctx.rotate(po.t);
    ctx.globalAlpha = 0.9;
    ctx.shadowBlur = 16;
    ctx.shadowColor = '#c026d3';
    ctx.drawImage(SPR.portal, -TILE/2, -TILE/2, TILE, TILE);
    ctx.restore();
    ctx.globalAlpha = 1;
  }

  // 树林
  for (const [key, f] of forests){
    if (!f.alive) continue;
    const [tx, ty] = key.split(',').map(Number);
    if (f.burn > 0){
      ctx.save();
      ctx.shadowBlur = 16; ctx.shadowColor = '#f97316';
      ctx.drawImage(SPR.forestBurn, tx*TILE, ty*TILE, TILE, TILE);
      ctx.restore();
    } else {
      ctx.drawImage(SPR.forest, tx*TILE, ty*TILE, TILE, TILE);
    }
  }
  // 掉落块
  for (const [key, c] of crumbles){
    if (c.gone) continue;
    const [tx, ty] = key.split(',').map(Number);
    let shake = 0;
    if (c.timer > 0) shake = Math.sin(worldTime*0.9) * Math.min(2, c.timer/150);
    const img = c.timer > 0 ? SPR.crystalWarn : SPR.crystal;
    ctx.drawImage(img, tx*TILE+shake, ty*TILE, TILE, TILE);
  }
  // 移动墙
  for (const m of movers){
    const mw = m.w*TILE, mh = m.h*TILE;
    const img = m.kind === 'h' ? SPR.wallH : SPR.wallV;
    ctx.drawImage(img, m.px, m.py, mw, mh);
    ctx.save();
    ctx.globalAlpha = 0.35 + 0.25*Math.sin(worldTime*0.2);
    ctx.shadowBlur = 16; ctx.shadowColor = '#ef4444';
    ctx.strokeStyle = '#ef4444'; ctx.lineWidth = 2;
    ctx.strokeRect(m.px+1, m.py+1, mw-2, mh-2);
    ctx.restore();
  }
  // 技能书
  for (const b of books){
    const y = b.y + Math.sin(b.bob)*3;
    ctx.save();
    ctx.shadowBlur = 18; ctx.shadowColor = '#a78bfa';
    ctx.drawImage(SPR.book, b.x-12, y-12, 24, 24);
    ctx.restore();
  }
  // 箭矢
  for (const a of arrows){
    if (!a.stuck && a.trail.length > 1){
      ctx.save();
      ctx.globalAlpha = 0.4;
      ctx.strokeStyle = a.onFire ? '#fb923c' : a.onIce ? '#a5f3fc' : '#cbd5e1';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(a.trail[0].x, a.trail[0].y);
      for (let i = 1; i < a.trail.length; i++)
        ctx.lineTo(a.trail[i].x, a.trail[i].y);
      ctx.lineTo(a.x, a.y);
      ctx.stroke();
      ctx.restore();
    }
    ctx.save();
    ctx.translate(a.x, a.y); ctx.rotate(a.angle);
    if (a.onFire){ ctx.shadowBlur = 16; ctx.shadowColor = '#f97316'; }
    else if (a.onIce){ ctx.shadowBlur = 16; ctx.shadowColor = '#a5f3fc'; }
    const img = a.onFire ? SPR.arrowFire : a.onIce ? SPR.arrowIce : SPR.arrow;
    ctx.drawImage(img, -8, -3, 16, 6);
    ctx.restore();
    if (a.stuck){
      ctx.save();
      ctx.globalAlpha = 0.4 + 0.3*Math.sin(worldTime*0.15);
      ctx.strokeStyle = a.onIce ? '#a5f3fc' : '#fbbf24';
      ctx.lineWidth = 1.2;
      ctx.beginPath(); ctx.arc(a.x, a.y, 12, 0, Math.PI*2); ctx.stroke();
      ctx.restore();
    }
  }

  // 玩家
  const sorted = [...players].sort((a,b) => {
    if (a.index === myIndex) return 1;
    if (b.index === myIndex) return -1;
    return a.y - b.y;
  });
  for (const p of sorted) drawPlayer(p);

  // 粒子
  for (const pt of particles){
    const alpha = pt.life / pt.maxLife;
    ctx.globalAlpha = alpha;
    ctx.fillStyle = pt.color;
    ctx.fillRect(pt.x-pt.size/2, pt.y-pt.size/2, pt.size, pt.size);
  }
  ctx.globalAlpha = 1;
}

/* ================= HUD ================= */
function updateHUD(){
  const hud = document.getElementById('hud');
  const teamData = [];
  for (let t = 0; t < gameConfig.teams; t++){
    let alive = 0, total = 0, kills = 0;
    for (const p of players){
      if (p.team !== t) continue;
      total++;
      if (!p.dead) alive++;
      kills += p.kills;
    }
    teamData.push({ t, alive, total, kills });
  }
  let html = '';
  for (const td of teamData){
    const team = TEAMS[td.t];
    const isMine = td.t === myTeam;
    html += `<div class="hud-item" style="${isMine?'background:rgba(59,130,246,.18);border:1px solid '+team.hex+'55':''}">
      <span class="dot" style="background:${team.hex}"></span>
      <span style="font-weight:${isMine?'700':'500'}">${team.name}</span>
      <span style="font-size:11px;color:#cbd5e1">${td.alive}/${td.total}</span>
      <span style="font-size:11px;color:#fbbf24">⚔${td.kills}</span>
    </div>`;
  }
  const me = players[myIndex];
  if (me){
    let meStatus;
    if (me.dead) meStatus = me.rescuable ? '💀待救援' : '☠️淘汰';
    else if (me.onFire > 0) meStatus = '🔥' + Math.ceil(me.onFire/60) + 's';
    else if (me.frozen > 0) meStatus = '❄️' + Math.ceil(me.frozen/60) + 's';
    else if (me.fallTimer > 0) meStatus = '⚠️坠落';
    else meStatus = '❤'.repeat(me.hp) + '♡'.repeat(Math.max(0, me.maxHp-me.hp));
    html += `<div class="hud-item" style="background:rgba(250,204,21,.12);border:1px solid rgba(250,204,21,.3)">
      <span style="font-weight:700">你</span>
      <span>${meStatus}</span>
      <span style="font-size:11px;color:#fbbf24">⚔${me.kills}</span>
    </div>`;
  }
  const tSec = Math.max(0, Math.floor(gameState.timeLeft / 60));
  const mm = String(Math.floor(tSec / 60)).padStart(2, '0');
  const ss = String(tSec % 60).padStart(2, '0');
  html += `<div class="timer ${tSec <= 30 ? 'warn' : ''}">${mm}:${ss}</div>`;
  hud.innerHTML = html;
}

/* ================= 输入 ================= */
const keys = {};
const mobileInputs = { left:0,right:0,up:0,down:0,jump:0,dash:0,sword:0,bow:0 };

window.addEventListener('keydown', e => {
  keys[e.code] = true;
  if (['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.code))
    e.preventDefault();
});
window.addEventListener('keyup', e => { keys[e.code] = false; });

function readInputs(){
  return {
    left:  (keys['KeyA'] || keys['ArrowLeft'] || mobileInputs.left) ? 1 : 0,
    right: (keys['KeyD'] || keys['ArrowRight'] || mobileInputs.right) ? 1 : 0,
    up:    (keys['KeyW'] || keys['ArrowUp'] || mobileInputs.up) ? 1 : 0,
    down:  (keys['KeyS'] || keys['ArrowDown'] || mobileInputs.down) ? 1 : 0,
    jump:  (keys['Space'] || mobileInputs.jump) ? 1 : 0,
    dash:  (keys['ShiftLeft'] || keys['ShiftRight'] || mobileInputs.dash) ? 1 : 0,
    sword: (keys['KeyJ'] || mobileInputs.sword) ? 1 : 0,
    bow:   (keys['KeyK'] || mobileInputs.bow) ? 1 : 0,
  };
}

document.querySelectorAll('[data-key]').forEach(btn => {
  const key = btn.dataset.key;
  const on = e => { e.preventDefault(); mobileInputs[key] = 1; btn.classList.add('pressed'); };
  const off = e => { e.preventDefault(); mobileInputs[key] = 0; btn.classList.remove('pressed'); };
  btn.addEventListener('pointerdown', on);
  btn.addEventListener('pointerup', off);
  btn.addEventListener('pointercancel', off);
  btn.addEventListener('pointerleave', off);
  btn.addEventListener('contextmenu', e => e.preventDefault());
});
const hasTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
if (hasTouch) document.getElementById('mobileUI').classList.add('active');

/* ================= 设置界面 ================= */
function bindGroup(id, setter){
  document.getElementById(id).addEventListener('click', e => {
    const btn = e.target.closest('button');
    if (!btn) return;
    document.querySelectorAll(`#${id} button`).forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    setter(btn.dataset.val);
    validateConfig();
    updateTeamPreview();
    updateHumanPickers();
  });
}
bindGroup('grpTeams', v => gameConfig.teams = parseInt(v));
bindGroup('grpPer', v => gameConfig.perTeam = parseInt(v));
bindGroup('grpAI', v => gameConfig.aiDiff = v);
bindGroup('grpHumans', v => gameConfig.humans = parseInt(v));

function validateConfig(){
  const maxHumans = Math.min(4, gameConfig.teams * gameConfig.perTeam);
  if (gameConfig.humans > maxHumans){
    gameConfig.humans = maxHumans;
    document.querySelectorAll('#grpHumans button').forEach(b => {
      b.classList.toggle('active', parseInt(b.dataset.val) === maxHumans);
    });
  }
  for (let h = 0; h < 4; h++){
    if (gameConfig.humanTeams[h] >= gameConfig.teams){
      gameConfig.humanTeams[h] = 0;
    }
  }
}

function updateTeamPreview(){
  const el = document.getElementById('teamPreview');
  let html = '';
  for (let t = 0; t < gameConfig.teams; t++){
    html += `<div class="team-chip" style="border-color:${TEAMS[t].hex}55">
      <span class="dot" style="background:${TEAMS[t].hex}"></span>
      <span>${TEAMS[t].name}</span>
      <span style="color:#64748b">×${gameConfig.perTeam}</span>
    </div>`;
  }
  el.innerHTML = html;
}

function updateHumanPickers(){
  const el = document.getElementById('humanTeamPickers');
  let html = '';
  for (let h = 0; h < gameConfig.humans; h++){
    const cur = gameConfig.humanTeams[h] || 0;
    html += `<div class="human-picker">
      <span class="label">玩家${h+1}${h===0?'(你)':''}</span>
      <div class="btn-group" data-human="${h}">`;
    for (let t = 0; t < gameConfig.teams; t++){
      html += `<button data-val="${t}" class="${cur === t ? 'active' : ''}">${TEAMS[t].name[0]}方</button>`;
    }
    html += `</div></div>`;
  }
  el.innerHTML = html;
  el.querySelectorAll('.btn-group').forEach(grp => {
    grp.addEventListener('click', e => {
      const btn = e.target.closest('button');
      if (!btn) return;
      const h = parseInt(grp.dataset.human);
      gameConfig.humanTeams[h] = parseInt(btn.dataset.val);
      updateHumanPickers();
    });
  });
}

validateConfig();
updateTeamPreview();
updateHumanPickers();

/* ================= 网络 ================= */
let peer = null, conn = null, isHost = false, roomCode = null;
let remoteInputs = { left:0,right:0,up:0,down:0,jump:0,dash:0,sword:0,bow:0 };
let remoteConnected = false;

function genCode(){
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  let s = '';
  for (let i = 0; i < 6; i++) s += chars[Math.floor(Math.random()*chars.length)];
  return s;
}

function openCreateRoom(){
  roomCode = genCode();
  peer = new Peer('arrowarena-' + roomCode);
  peer.on('open', () => {
    isHost = true;
    showScreen('waiting');
    document.getElementById('roomCodeDisplay').textContent = roomCode;
    document.getElementById('waitStatus').textContent = '等待队友加入（或直接开始 AI 对战）…';
  });
  peer.on('connection', c => {
    if (conn && conn.open){ c.close(); return; }
    conn = c;
    conn.on('open', () => {
      remoteConnected = true;
      conn.send({ type:'welcome', config: gameConfig, slot: 1 });
      document.getElementById('waitStatus').innerHTML = '✅ 队友已加入！<br>点击开始游戏';
    });
    conn.on('data', d => {
      if (d.type === 'input') remoteInputs = d.inputs;
    });
    conn.on('close', () => {
      remoteConnected = false;
      toast('队友已断开连接');
    });
  });
  peer.on('error', err => {
    if (err.type === 'unavailable-id') openCreateRoom();
    else { toast('网络错误：' + err.message); leaveRoom(); }
  });
}

function joinRoom(code){
  code = (code || '').toUpperCase().trim();
  if (code.length !== 6) return toast('请输入 6 位房间码');
  peer = new Peer();
  peer.on('open', () => {
    isHost = false;
    conn = peer.connect('arrowarena-' + code);
    conn.on('open', () => { remoteConnected = true; });
    conn.on('data', d => {
      if (d.type === 'welcome'){
        gameConfig = d.config;
        mySlotIndex = d.slot;
        startGame();
      } else if (d.type === 'snap'){
        applySnapshot(d.snap);
      } else if (d.type === 'rematch'){
        resetWorld(); lastTime = performance.now();
        document.getElementById('resultModal').classList.remove('active');
      }
    });
    conn.on('close', () => { toast('与房主的连接已断开'); leaveRoom(); });
  });
  peer.on('error', err => {
    if (err.type === 'peer-unavailable') toast('房间不存在或已关闭');
    else toast('连接失败：' + err.message);
    cleanup();
  });
}

function startGame(){
  resetWorld();
  showScreen('game');
  lastTime = performance.now();
  document.getElementById('resultModal').classList.remove('active');
}

function copyRoomCode(){
  if (!roomCode) return;
  if (navigator.clipboard){
    navigator.clipboard.writeText(roomCode).then(() => toast('已复制：' + roomCode));
  } else {
    const ta = document.createElement('textarea');
    ta.value = roomCode;
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
    toast('已复制：' + roomCode);
  }
}

function cleanup(){
  if (conn){ try { conn.close(); } catch(e){} conn = null; }
  if (peer){ try { peer.destroy(); } catch(e){} peer = null; }
  isHost = false; remoteConnected = false; roomCode = null;
}

function leaveRoom(){
  cleanup();
  players = []; arrows = []; books = []; particles = [];
  document.getElementById('resultModal').classList.remove('active');
  showScreen('setup');
  document.getElementById('joinCode').value = '';
}

function rematch(){
  document.getElementById('resultModal').classList.remove('active');
  if (isHost){
    resetWorld();
    lastTime = performance.now();
    if (conn && conn.open) conn.send({ type:'rematch' });
  }
}

function backToSetup(){
  document.getElementById('resultModal').classList.remove('active');
  leaveRoom();
}

/* ================= 快照 ================= */
function makeSnapshot(){
  return {
    t: worldTime,
    timeLeft: gameState.timeLeft,
    ended: gameState.ended,
    players: players.map(p => ({
      x:p.x, y:p.y, vx:p.vx, vy:p.vy, facing:p.facing,
      dead:p.dead, deadTimer:p.deadTimer, rescueTimer:p.rescueTimer,
      rescuable:p.rescuable, deathReason:p.deathReason,
      onFire:p.onFire, frozen:p.frozen, arrows:p.arrows, hp:p.hp,
      kills:p.kills, deaths:p.deaths,
      skill:p.skill ? { type:p.skill.type, timer:p.skill.timer } : null,
      hurtFlash:p.hurtFlash, dashTime:p.dashTime,
      swordTime:p.swordTime, charging:p.charging, chargeTime:p.chargeTime,
      fallTimer:p.fallTimer
    })),
    arrows: arrows.map(a => ({
      x:a.x, y:a.y, vx:a.vx, vy:a.vy, angle:a.angle, speed:a.speed, curve:a.curve,
      onFire:a.onFire, onIce:a.onIce, stuck:a.stuck, owner:a.owner, life:a.life,
      trail:a.trail.slice(-5)
    })),
    crumbles: [...crumbles].map(([k,v]) => [k, v.gone, v.timer, v.respawn]),
    forests: [...forests].map(([k,v]) => [k, v.alive, v.burn]),
    movers: movers.map(m => [m.px, m.py]),
    books: books.map(b => ({ x:b.x, y:b.y, type:b.type, life:b.life, bob:b.bob })),
    particles: particles.slice(0, 40).map(p => ({
      x:p.x, y:p.y, vx:p.vx, vy:p.vy, life:p.life, maxLife:p.maxLife,
      color:p.color, size:p.size
    })),
  };
}

function applySnapshot(s){
  worldTime = s.t;
  gameState.timeLeft = s.timeLeft;
  for (let i = 0; i < s.players.length && i < players.length; i++){
    const src = s.players[i], dst = players[i];
    if (i === myIndex){
      dst.x += (src.x - dst.x) * 0.5;
      dst.y += (src.y - dst.y) * 0.5;
    } else {
      dst.x = src.x; dst.y = src.y;
    }
    dst.vx = src.vx; dst.vy = src.vy; dst.facing = src.facing;
    dst.dead = src.dead; dst.deadTimer = src.deadTimer; dst.rescueTimer = src.rescueTimer;
    dst.rescuable = src.rescuable; dst.deathReason = src.deathReason;
    dst.onFire = src.onFire; dst.frozen = src.frozen;
    dst.arrows = src.arrows; dst.hp = src.hp;
    dst.kills = src.kills; dst.deaths = src.deaths;
    dst.skill = src.skill ? { type:src.skill.type, timer:src.skill.timer } : null;
    dst.hurtFlash = src.hurtFlash; dst.dashTime = src.dashTime;
    dst.swordTime = src.swordTime;
    dst.charging = src.charging; dst.chargeTime = src.chargeTime;
    dst.fallTimer = src.fallTimer || 0;
  }
  arrows = s.arrows.map(a => ({ ...a, trail: a.trail || [] }));
  for (const [k, gone, timer, respawn] of s.crumbles){
    const c = crumbles.get(k);
    if (c){ c.gone = gone; c.timer = timer; c.respawn = respawn; }
  }
  for (const [k, alive, burn] of s.forests){
    const f = forests.get(k);
    if (f){ f.alive = alive; f.burn = burn; }
  }
  for (let i = 0; i < s.movers.length; i++){
    movers[i].px = s.movers[i][0]; movers[i].py = s.movers[i][1];
  }
  books = s.books.map(b => ({ ...b }));
  particles = s.particles.map(p => ({ ...p }));
  if (s.ended && !gameState.ended){ gameState.ended = true; endGame(); }
}

/* ================= 主循环 ================= */
let lastTime = 0, acc = 0;
const STEP = 1000/60;

function loop(now){
  requestAnimationFrame(loop);
  if (!document.getElementById('screen-game').classList.contains('active')) return;
  if (!players.length) return;

  const dt = Math.min(now - lastTime, 100);
  lastTime = now;
  acc += dt;

  let iter = 0;
  while (acc >= STEP && iter < 4){
    acc -= STEP; iter++;

    if (!gameState.ended){
      if (isHost){
        for (const p of players){
          if (p.index === myIndex) p.inputs = readInputs();
          else if (p.isAI) updateAI(p);
          else if (remoteConnected && humanSlots[mySlotIndex] === p.index){
            p.inputs = remoteInputs;
          } else {
            p.inputs = { left:0,right:0,up:0,down:0,jump:0,dash:0,sword:0,bow:0 };
          }
        }
        updateTerrain();
        for (const p of players) updatePlayer(p);
        updateArrows();
        checkGameEnd();
        if (conn && conn.open && remoteConnected){
          conn.send({ type:'snap', snap: makeSnapshot() });
        }
      } else {
        if (conn && conn.open) conn.send({ type:'input', inputs: readInputs() });
        const me = players[myIndex];
        if (me && !me.dead){
          if (me.skill && me.skill.timer > 0) me.skill.timer--;
          if (me.onFire > 0) me.onFire--;
          if (me.frozen > 0) me.frozen--;
        }
        for (let i = particles.length-1; i >= 0; i--){
          const pt = particles[i];
          pt.x += pt.vx; pt.y += pt.vy; pt.vy += 0.05; pt.life--;
          if (pt.life <= 0) particles.splice(i,1);
        }
        for (const b of books) b.bob += 0.08;
        worldTime++;
      }
    }
  }

  render();
  updateHUD();
}

/* ================= UI ================= */
function showScreen(name){
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById('screen-' + name).classList.add('active');
}
function toast(msg){
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(el._t);
  el._t = setTimeout(() => el.classList.remove('show'), 2200);
}

/* ================= 启动 ================= */
document.getElementById('joinCode').addEventListener('keydown', e => {
  if (e.key === 'Enter') joinRoom(e.target.value);
});
document.getElementById('joinCode').addEventListener('input', e => {
  e.target.value = e.target.value.toUpperCase();
});

loadSprites();
parseMap();
requestAnimationFrame(loop);
</script>
