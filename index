<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no,viewport-fit=cover">
<title>箭回旋 · 俯视竞技场</title>
<script src="https://unpkg.com/peerjs@1.5.2/dist/peerjs.min.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{overflow:hidden;touch-action:none}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;
background:#05070f;color:#e2e8f0;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}
.screen{display:none;width:100%;max-width:940px}
.screen.active{display:block;animation:fadeIn .25s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.card{background:rgba(30,41,59,.9);backdrop-filter:blur(12px);border:1px solid rgba(148,163,184,.12);
border-radius:18px;padding:22px;box-shadow:0 20px 50px rgba(0,0,0,.5);max-width:520px;margin:0 auto;max-height:92vh;overflow-y:auto}
h1{font-size:26px;margin-bottom:6px;text-align:center;letter-spacing:3px}
h2{font-size:11px;margin-bottom:18px;text-align:center;color:#64748b;font-weight:400;letter-spacing:4px}
h3{font-size:13px;color:#94a3b8;margin:16px 0 8px;text-align:center;font-weight:500}
button{font-family:inherit;font-size:15px;padding:13px 20px;border:none;border-radius:11px;
background:linear-gradient(135deg,#3b82f6,#2563eb);color:#fff;cursor:pointer;transition:all .18s;
width:100%;margin-bottom:10px;font-weight:600;letter-spacing:.5px}
button:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 8px 20px rgba(59,130,246,.35)}
button:disabled{opacity:.4;cursor:not-allowed}
button.secondary{background:#334155}
input{font-family:inherit;font-size:15px;padding:13px;border-radius:11px;border:1px solid #334155;
background:#0f172a;color:#e2e8f0;width:100%;margin-bottom:10px;text-transform:uppercase}
input:focus{outline:none;border-color:#3b82f6}
input::placeholder{color:#475569;text-transform:none}
.row{display:flex;gap:10px}
.row>input{flex:2;margin-bottom:0}
.row>button{flex:1;margin-bottom:0}
.room-code{font-size:36px;font-weight:800;letter-spacing:10px;text-align:center;padding:22px;
background:#0f172a;border:1px dashed #334155;border-radius:12px;margin-bottom:14px;
color:#60a5fa;font-family:'Courier New',monospace;text-indent:10px}
.hud{display:flex;justify-content:space-between;align-items:center;padding:8px 12px;
background:rgba(15,23,42,.92);border-radius:12px;margin-bottom:8px;font-size:12px;gap:8px;flex-wrap:wrap}
.hud-item{display:flex;align-items:center;gap:5px;padding:3px 8px;border-radius:6px}
.dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}
.timer{font-family:'Courier New',monospace;font-size:16px;font-weight:800;color:#fbbf24;
padding:4px 12px;background:#0f172a;border-radius:8px;letter-spacing:2px}
.timer.warn{color:#ef4444;animation:blink 1s infinite}
@keyframes blink{50%{opacity:.4}}
canvas{display:block;width:100%;height:auto;border-radius:14px;
box-shadow:0 12px 40px rgba(0,0,0,.6);background:#05070f}
.hidden{display:none!important}
.toast{position:fixed;bottom:30px;left:50%;transform:translateX(-50%) translateY(20px);
background:#1e293b;border:1px solid #334155;padding:12px 24px;border-radius:10px;font-size:14px;
opacity:0;pointer-events:none;transition:all .3s;z-index:999}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.legend{font-size:11px;color:#64748b;text-align:center;line-height:1.8;margin-top:10px}
.setting-row{margin-bottom:14px}
.setting-row>label{display:block;font-size:12px;color:#94a3b8;margin-bottom:6px;
text-align:center;font-weight:500;letter-spacing:1px}
.btn-group{display:flex;gap:5px;justify-content:center;flex-wrap:wrap}
.btn-group button{flex:1;min-width:44px;margin:0;padding:9px 6px;font-size:12px;
background:#1e293b;border:1.5px solid transparent;color:#94a3b8;font-weight:600}
.btn-group button.active{background:linear-gradient(135deg,#3b82f6,#2563eb);color:#fff;
border-color:#60a5fa;box-shadow:0 4px 14px rgba(59,130,246,.4)}
.btn-group button:hover:not(.active){background:#334155;color:#cbd5e1;transform:none;box-shadow:none}
.team-preview{display:flex;justify-content:center;gap:6px;margin-top:10px;flex-wrap:wrap}
.team-chip{display:flex;align-items:center;gap:4px;padding:5px 10px;border-radius:8px;
background:#0f172a;font-size:12px;border:1px solid #1e293b}
.team-chip .dot{width:8px;height:8px}
.human-picker{display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:6px}
.human-picker .label{font-size:12px;color:#94a3b8;min-width:70px;text-align:right}
.human-picker .btn-group{flex:1}
.human-picker .btn-group button{min-width:40px;padding:6px 4px;font-size:11px}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.78);backdrop-filter:blur(6px);
display:none;align-items:center;justify-content:center;z-index:2000;padding:20px}
.modal.active{display:flex;animation:fadeIn .3s ease}
.modal-content{background:linear-gradient(160deg,#1e293b,#0f172a);
border:2px solid rgba(148,163,184,.2);border-radius:20px;padding:28px 24px;
max-width:460px;width:100%;box-shadow:0 30px 80px rgba(0,0,0,.8);max-height:90vh;overflow-y:auto}
.winner-title{font-size:24px;font-weight:800;text-align:center;margin-bottom:4px;letter-spacing:2px}
.winner-sub{font-size:13px;text-align:center;color:#94a3b8;margin-bottom:20px}
.stats-list{background:#0a0e1a;border-radius:12px;padding:14px;margin-bottom:16px}
.stat-row{display:flex;align-items:center;gap:10px;padding:8px 0;
border-bottom:1px solid #1e293b;font-size:13px}
.stat-row:last-child{border-bottom:none}
.stat-row.winner-row{background:rgba(59,130,246,.1);margin:0 -8px;padding:8px;border-radius:8px}
.stat-bar{flex:1;height:6px;background:#1e293b;border-radius:3px;overflow:hidden}
.stat-bar-fill{height:100%;border-radius:3px;transition:width .6s}
.mvp-box{background:linear-gradient(135deg,rgba(250,204,21,.15),rgba(234,179,8,.08));
border:1px solid rgba(250,204,21,.35);border-radius:12px;padding:14px;margin-bottom:16px;
display:flex;align-items:center;gap:12px}
.mvp-icon{font-size:28px;filter:drop-shadow(0 0 10px rgba(250,204,21,.6))}
.mvp-info{flex:1}
.mvp-name{font-size:15px;font-weight:700;color:#fbbf24;margin-bottom:2px}
.mvp-stats{font-size:12px;color:#94a3b8}
.mobile-ui{position:fixed;inset:0;pointer-events:none;display:none;z-index:100}
.mobile-ui.active{display:block}
.dpad{position:absolute;left:max(4vw,16px);bottom:max(4vh,16px);
width:min(34vw,170px);height:min(34vw,170px);pointer-events:auto}
.dpad button{position:absolute;width:34%;height:34%;border:none;border-radius:14px;
background:rgba(59,130,246,.35);border:1.5px solid rgba(96,165,250,.55);
color:#e0f2fe;font-size:22px;padding:0;margin:0;font-weight:700;
backdrop-filter:blur(4px);transition:all .08s;line-height:1;min-width:auto}
.dpad button.pressed,.dpad button:active{background:rgba(59,130,246,.65);transform:scale(.94)}
.dpad .up{left:33%;top:0}
.dpad .down{left:33%;bottom:0}
.dpad .left{left:0;top:33%}
.dpad .right{right:0;top:33%}
.actions{position:absolute;right:max(4vw,16px);bottom:max(4vh,16px);
width:min(38vw,190px);height:min(38vw,190px);pointer-events:auto}
.actions button{position:absolute;width:48%;height:48%;border-radius:50%;
border:2px solid rgba(255,255,255,.3);color:#fff;font-size:15px;font-weight:800;
padding:0;margin:0;backdrop-filter:blur(4px);transition:all .08s;min-width:auto}
.actions button.pressed,.actions button:active{transform:scale(.9);filter:brightness(1.4)}
.actions .jump{right:26%;top:0;background:rgba(34,197,94,.5)}
.actions .dash{left:0;top:26%;background:rgba(59,130,246,.5)}
.actions .sword{right:0;top:26%;background:rgba(234,179,8,.55)}
.actions .bow{right:26%;bottom:0;background:rgba(239,68,68,.5)}
.skill-banner{position:fixed;top:26%;left:50%;padding:14px 28px;
background:rgba(15,23,42,.96);border:2px solid #60a5fa;border-radius:14px;
font-size:17px;font-weight:800;letter-spacing:2px;color:#60a5fa;
pointer-events:none;z-index:1000;opacity:0;transform:translate(-50%,-50%) scale(.7)}
@keyframes skillPop{
0%{opacity:0;transform:translate(-50%,-50%) scale(.7)}
15%{opacity:1;transform:translate(-50%,-50%) scale(1.1)}
30%,80%{opacity:1;transform:translate(-50%,-50%) scale(1)}
100%{opacity:0;transform:translate(-50%,-50%) scale(1)}
}
@media (max-width:900px){body{padding:6px}.card{padding:16px}h1{font-size:22px}}
</style>
</head>
<body>

<div class="screen active" id="screen-setup">
  <div class="card">
    <h1>🏹 箭回旋</h1>
    <h2>ARROW ARENA · 俯视竞技场</h2>
    <div class="setting-row">
      <label>阵营数量</label>
      <div class="btn-group" id="grpTeams">
        <button data-val="2" class="active">2 阵营</button>
        <button data-val="3">3 阵营</button>
        <button data-val="4">4 阵营</button>
      </div>
    </div>
    <div class="setting-row">
      <label>每阵营角色数</label>
      <div class="btn-group" id="grpPer">
        <button data-val="1">1</button>
        <button data-val="2" class="active">2</button>
        <button data-val="3">3</button>
        <button data-val="4">4</button>
        <button data-val="5">5</button>
      </div>
    </div>
    <div class="setting-row">
      <label>AI 难度</label>
      <div class="btn-group" id="grpAI">
        <button data-val="easy">简单</button>
        <button data-val="normal" class="active">一般</button>
        <button data-val="hard">困难</button>
        <button data-val="hell">地狱</button>
      </div>
    </div>
    <div class="setting-row">
      <label>真人玩家数</label>
      <div class="btn-group" id="grpHumans">
        <button data-val="1" class="active">1</button>
        <button data-val="2">2</button>
        <button data-val="3">3</button>
        <button data-val="4">4</button>
      </div>
    </div>
    <div class="setting-row" id="humanTeamsRow">
      <label>真人所属阵营</label>
      <div id="humanTeamPickers"></div>
    </div>
    <div class="team-preview" id="teamPreview"></div>
    <button onclick="openCreateRoom()" style="margin-top:14px">🌐 创建房间</button>
    <div class="row" style="margin-top:10px">
      <input id="joinCode" placeholder="输入 6 位房间码" maxlength="6" autocomplete="off">
      <button class="secondary" onclick="joinRoom(document.getElementById('joinCode').value)">加入</button>
    </div>
    <div class="legend">
      每局 5 分钟 · 存活最多阵营获胜 · 击杀最多者 MVP<br>
      WASD 前后左右移动 · J 剑格挡 · K 长按蓄力射箭<br>
      掉入深渊不可救 · 着火15s烧死不可救 · 冰冻15s可救<br>
      💧 喷泉灭火 · 🌀 传送门连接四角小岛
    </div>
  </div>
</div>

<div class="screen" id="screen-waiting">
  <div class="card">
    <h3>房间码 · 分享给队友</h3>
    <div class="room-code" id="roomCodeDisplay">------</div>
    <button class="secondary" onclick="copyRoomCode()">📋 复制房间码</button>
    <div style="margin-top:14px;font-size:13px;color:#94a3b8;text-align:center" id="waitStatus">
      等待队友加入（或直接开始 AI 对战）…
    </div>
    <button onclick="startGame()" style="margin-top:16px">▶ 开始游戏</button>
    <button class="secondary" onclick="leaveRoom()">返回设置</button>
  </div>
</div>

<div class="screen" id="screen-game">
  <div class="hud" id="hud"></div>
  <canvas id="canvas" width="896" height="504"></canvas>
  <button class="secondary" onclick="leaveRoom()" style="margin-top:8px">退出游戏</button>
</div>

<div class="modal" id="resultModal">
  <div class="modal-content">
    <div class="winner-title" id="winnerTitle">阵营获胜！</div>
    <div class="winner-sub" id="winnerSub"></div>
    <div class="stats-list" id="statsList"></div>
    <div class="mvp-box">
      <div class="mvp-icon">⭐</div>
      <div class="mvp-info">
        <div class="mvp-name" id="mvpName">—</div>
        <div class="mvp-stats" id="mvpStats">—</div>
      </div>
    </div>
    <button onclick="rematch()">🔄 再来一局</button>
    <button class="secondary" onclick="backToSetup()">⚙ 返回设置</button>
  </div>
</div>

<div class="skill-banner hidden" id="skillBanner"></div>
<div class="toast" id="toast"></div>

<div class="mobile-ui" id="mobileUI">
  <div class="dpad">
    <button class="up" data-key="up">▲</button>
    <button class="left" data-key="left">◀</button>
    <button class="right" data-key="right">▶</button>
    <button class="down" data-key="down">▼</button>
  </div>
  <div class="actions">
    <button class="jump" data-key="jump">跳</button>
    <button class="dash" data-key="dash">冲</button>
    <button class="sword" data-key="sword">剑</button>
    <button class="bow" data-key="bow">弓</button>
  </div>
</div>

<script>
/* ================= 常量 ================= */
const TILE = 28;
const MAP_W = 32, MAP_H = 18;
const W = TILE * MAP_W, H = TILE * MAP_H;

const MOVE_SPEED = 3.2;
const DASH_SPEED = 10;
const DASH_TIME = 9;
const DASH_CD = 40;
const ARROW_MAX = 5;
const RESCUE_FRAMES = 900;
const BURN_FRAMES = 900;
const FREEZE_FRAMES = 900;
const FALL_GRACE = 70;      // 掉入深渊的宽限帧
const ROUND_FRAMES = 300 * 60;

const T = { EMPTY:0, FLOOR:1, WALL:2, VOID:3, CRYSTAL:4, FOREST:5 };

const SKILLS = {
  swap:   { name:'颠三倒四', icon:'🔄', color:'#a78bfa', dur:480 },
  multi:  { name:'万箭齐发', icon:'🎯', color:'#f472b6', dur:600 },
  aim:    { name:'随心所欲', icon:'👁️', color:'#38bdf8', dur:600 },
  fire:   { name:'火凤鸣鸾', icon:'🔥', color:'#fb923c', dur:900 },
  ice:    { name:'冰雪如针', icon:'❄️', color:'#a5f3fc', dur:900 },
  double: { name:'左右开弓', icon:'⚡', color:'#facc15', dur:600 },
};
const BOOK_TYPES = ['swap','multi','aim','fire','ice','double'];
const RESCUE_RULES = { arrow:true, crush:true, burn:false, fall:false, freeze:true };
const REASON_TEXT  = { arrow:'被箭射死', crush:'被墙压死', burn:'被烈焰吞噬',
                       fall:'坠落深渊', freeze:'被冻结击杀' };

const TEAMS = [
  { name:'红方', body:'#dc2626', body2:'#ef4444', cape:'#7f1d1d', helmet:'#b91c1c', hex:'#ef4444' },
  { name:'黄方', body:'#ca8a04', body2:'#eab308', cape:'#713f12', helmet:'#a16207', hex:'#eab308' },
  { name:'绿方', body:'#16a34a', body2:'#22c55e', cape:'#14532d', helmet:'#15803d', hex:'#22c55e' },
  { name:'蓝方', body:'#2563eb', body2:'#3b82f6', cape:'#1e3a8a', helmet:'#1d4ed8', hex:'#3b82f6' },
];

/* 俯视地图： # 墙  . 地板  o 小岛地板  ~ 深渊  F 树林  C 掉落块 */
const MAP_STR = [
"################################",
"#..ooo....................ooo..#",
"#..ooo....................ooo..#",
"#..ooo....................ooo..#",
"#~~~~~~..................~~~~~~#",
"#~~~~~~..................~~~~~~#",
"#..............................#",
"#....F..F....F..F....F..F......#",
"#..............................#",
"#...CCCCC....CCCCC....CCCCC....#",
"#..............................#",
"#....F..F....F..F....F..F......#",
"#~~~~~~..................~~~~~~#",
"#~~~~~~..................~~~~~~#",
"#..ooo....................ooo..#",
"#..ooo....................ooo..#",
"#..ooo....................ooo..#",
"################################",
];

/* 传送门（小岛 ↔ 大陆成对） */
const PORTALS = [
  { a:{x:4,y:2},  b:{x:4,y:7}  },
  { a:{x:27,y:2}, b:{x:27,y:7} },
  { a:{x:4,y:15}, b:{x:4,y:10} },
  { a:{x:27,y:15},b:{x:27,y:10}},
];

/* 移动墙配置（像素为瓦片坐标） */
const MOVERS_CFG = [
  { kind:'h', ox:10, oy:8,  w:1, h:2, range:3, speed:0.012 },
  { kind:'v', ox:16, oy:8,  w:2, h:1, range:1, speed:0.014 },
  { kind:'h', ox:22, oy:10, w:1, h:2, range:2, speed:0.011 },
];

/* ================= SVG 精灵 ================= */
function svgURI(s){return 'data:image/svg+xml;charset=utf-8,'+encodeURIComponent(s)}
function makeImg(s){const i=new Image();i.src=svgURI(s);return i}

/* 俯视地板：带纹路的石板 */
const SVG_FLOOR = `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 28 28">
<defs><linearGradient id="fl" x1="0" y1="0" x2="0" y2="1">
<stop offset="0" stop-color="#475569"/><stop offset="1" stop-color="#334155"/></linearGradient></defs>
<rect width="28" height="28" fill="url(#fl)"/>
<path d="M0,14 L28,14" stroke="#1e293b" stroke-width="0.6" opacity="0.6"/>
<path d="M14,0 L14,28" stroke="#1e293b" stroke-width="0.6" opacity="0.6"/>
<circle cx="7" cy="7" r="0.8" fill="#1e293b" opacity="0.4"/>
