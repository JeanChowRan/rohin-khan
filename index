<circle cx="8" cy="8" r="0.7" fill="#1e293b" opacity="0.6"/>
<circle cx="22" cy="20" r="0.5" fill="#1e293b" opacity="0.5"/></svg>`;

/* 墙：石块 */
const SVG_WALL = `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 28 28">
<defs><linearGradient id="wl" x1="0" y1="0" x2="0" y2="1">
<stop offset="0" stop-color="#7c3aed"/><stop offset="1" stop-color="#4c1d95"/></linearGradient></defs>
<rect width="28" height="28" fill="url(#wl)"/>
<path d="M0,0 L28,0 L28,3 L0,3 Z" fill="#a78bfa" opacity="0.6"/>
<path d="M0,25 L28,25 L28,28 L0,28 Z" fill="#2e1065"/>
<path d="M6,8 L9,14 L7,20" stroke="#2e1065" stroke-width="1" fill="none" opacity="0.7"/>
<circle cx="12" cy="10" r="1.2" fill="#2e1065" opacity="0.5"/>
