/* 小岛地板：略带绿色苔藓 */
const SVG_ISLE = `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 28 28">
<defs><linearGradient id="il" x1="0" y1="0" x2="0" y2="1">
